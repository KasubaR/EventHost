APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@eventhostzm.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="info@eventhostzm.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LENCO_API_BASE_URL=https://api.sandbox.lenco.co/access/v2
LENCO_API_SECRET_KEY=
LENCO_PUBLIC_KEY=
LENCO_WEBHOOK_SECRET=
LENCO_WEBHOOK_URL=
LENCO_WEBHOOK_PATH=lenco/webhook
LENCO_ENVIRONMENT=sandbox
LENCO_PAY_SCRIPT_URL=
LENCO_PENDING_MAX_AGE_HOURS=24
LENCO_STUCK_PAYMENT_HOURS=2
LENCO_POLL_MAX_PER_RUN=50
LENCO_POLL_THROTTLE_MS=200
LENCO_BANK_TRANSFER_ENABLED=true

LOG_PAYMENTS_LEVEL=debug
LOG_PAYMENTS_DAYS=90

# Emails Accepted guests a reminder 7 days, 1 day and 0 days before an event (Pro+ hosts only).
# Off until this is true. Needs the scheduler and a queue worker. See plans/guest-email-reminders.md.
COMM_GUEST_EMAIL_REMINDERS_ENABLED=false

# Guest contributions are off platform-wide until this is true.
CONTRIBUTIONS_ENABLED=false

# Days a deleted event stays restorable before events:purge-deleted removes it permanently.
# 0 = never purge (the default). Events that have taken money are never purged.
# Before turning this on, set the STARTS_AT release date (YYYY-MM-DD) so trash that already exists
# gets a full window from then; the command refuses to run against old trash without it.
# See plans/event-retention.md before changing either.
EVENT_TRASH_RETENTION_DAYS=0
EVENT_TRASH_RETENTION_STARTS_AT=

ANDROID_PACKAGE_NAME=com.sunconnecttechnologies.eventhost
ANDROID_SHA256_FINGERPRINTS=

# Google Maps Platform key (Maps JavaScript, Places, Geocoding, Embed APIs all enabled on it).
# Blank by default: the venue picker falls back to Leaflet/OpenStreetMap and public pages fall
# back to a plain "Open in Google Maps" link until this is set. See plans/google-maps.md.
GOOGLE_MAPS_API_KEY=

# Admin act-as-client sessions (plans/admin-create-events.md). Off by default. With the help-request gate on
# (Step 0, not built yet) no session can start, so leave REQUIRE_REQUEST alone outside local dev.
ADMIN_ACT_AS_ENABLED=false
ADMIN_ACT_AS_REQUIRE_REQUEST=true
ADMIN_ACT_AS_TTL_MINUTES=60
